# Copy this to .env for local dev (and load it, e.g. with python-dotenv,
# or just export these manually). In production, set these as real
# environment variables in your hosting provider's dashboard -- never
# commit actual keys to git.

ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Frontend domain allowed to call this API in production.
# Leave unset (or "*") for local dev.
FRONTEND_ORIGIN=https://your-frontend-domain.vercel.app

# Rate limit per IP for the /api/analyze endpoint.
UPLOAD_RATE_LIMIT=10 per hour

# Supabase (optional -- falls back to a local events.jsonl file if unset)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key
